              <Font>Times New Roman,9</Font>
              <Guid>373c0c10768f4d919eaab79f06971944</Guid>
              <Margins>0,0,0,0</Margins>
              <Name>Text68</Name>
              <Page isRef="5" />
              <Parent isRef="6" />
              <Text>3.3. Bên mua nhớ trình biên nhận này khi nhận hồ sơ</Text>
              <TextBrush>Black</TextBrush>
              <TextFormat Ref="85" type="CustomFormat" isKey="true">
