            <Text114 Ref="388" type="Text" isKey="true">
              <Brush>Transparent</Brush>
              <ClientRectangle>0.1,0.8,5.2,0.4</ClientRectangle>
              <Conditions isList="true" count="0" />
              <Font>Times New Roman,10</Font>
